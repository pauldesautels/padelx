{
  "name": "padelx-firestore-rules-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test:beta": "node --test test/beta_enrollment_safety.test.mjs",
    "test:beta-enrollment": "node --test test/beta_enrollment_safety.test.mjs",
    "test:migration": "node --test test/migrate_phase8a_safety.test.mjs test/migrate_phase8_scalability_safety.test.mjs",
    "test:functions": "firebase emulators:exec --project demo-padelx-phase8 --only auth,firestore,functions \"node --test test/functions_emulator.test.mjs\"",
    "test:rules": "firebase emulators:exec --project demo-padelx-phase8 --only firestore \"node --test test/firestore_rules.test.mjs\"",
    "test:deletion-worker": "firebase emulators:exec --project demo-padelx-phase8 --only auth,firestore \"node --test test/account_deletion_worker.test.mjs\"",
    "test:backend": "node --test test/backend_foundation.test.mjs test/account_deletion.test.mjs",
    "test:admission": "firebase emulators:exec --project demo-padelx-phase8 --only auth,firestore,functions \"node --test test/account_deletion_emulator.test.mjs\"",
    "test:deletion": "firebase emulators:exec --project demo-padelx-phase8 --only auth,firestore,functions \"node --test --test-concurrency=1 test/account_deletion*.mjs test/backend_foundation.test.mjs test/functions_emulator.test.mjs test/firestore_rules.test.mjs\"",
    "prepare:deletion": "node tool/prepare_account_deletion.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.2.1",
    "firebase-admin": "^13.5.0"
  }
}
