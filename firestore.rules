rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function accountDeleting(uid) {
      return exists(/databases/$(database)/documents/accountDeletionBarriers/$(uid));
    }

    function enforcementExpired(uid) {
      let data = get(
        /databases/$(database)/documents/accountEnforcement/$(uid)
      ).data;
      return data.schemaVersion == 1
        && data.uid == uid
        && data.status == 'suspended'
        && data.expiresAt is timestamp
        && data.expiresAt <= request.time;
    }

    function activeAccount(uid) {
      let enforcementPath = /databases/$(database)/documents/accountEnforcement/$(uid);
      return !accountDeleting(uid) && (
        !exists(enforcementPath)
        || enforcementExpired(uid)
      );
    }

    function activePublicAccount(uid) {
      return activeAccount(uid)
        && exists(/databases/$(database)/documents/publicProfiles/$(uid));
    }

    function verifiedUser() {
      return request.auth != null && activeAccount(request.auth.uid)
        && request.auth.token.email_verified == true;
    }

    function validDisplayName(value) {
      return value is string && value.size() >= 2 && value.size() <= 40;
    }

    function validProfileLevel(value) {
      return value is string && (
        value.matches('^(Level )?([1-6](\\.5)?|7)$')
        || value in ['Beginner', 'Intermediate', 'Advanced']
      );
    }

    function validMatchLevel(value) {
      return value is string
        && value.matches('^Level ([1-6](\\.5)?|7)$');
    }

    function validDiscoveryLocation(location) {
      return location is map
        && location.keys().hasAll(['country', 'countryCode', 'city', 'area'])
        && location.keys().hasOnly([
          'country', 'countryCode', 'city', 'cityId', 'area', 'areaId',
          'latitude', 'longitude'
        ])
        && location.country is string && location.country.size() <= 80
        && location.countryCode is string
        && location.city is string && location.city.size() <= 80
        && location.area is string && location.area.size() <= 100
        && (!('cityId' in location) || (
          location.cityId is string && location.cityId.size() >= 1
          && location.cityId.size() <= 256 && location.city.size() >= 1
        ))
        && (!('areaId' in location) || (
          location.areaId is string && location.areaId.size() >= 1
          && location.areaId.size() <= 256 && location.area.size() >= 1
        ))
        && (
          (
            location.country == ''
            && location.countryCode == ''
            && location.city == ''
            && location.area == ''
          )
          || (
            location.country.size() >= 2
            && location.countryCode.size() == 2
            && location.city.size() >= 1
          )
        )
        && (!('latitude' in location) || (
          location.latitude is number
          && location.latitude >= -90 && location.latitude <= 90
        ))
        && (!('longitude' in location) || (
          location.longitude is number
          && location.longitude >= -180 && location.longitude <= 180
        ))
        && (('latitude' in location) == ('longitude' in location));
    }

    function validPreferredSide(value) {
      return value is string && value in ['left', 'right', 'either'];
    }

    function validPlayFrequency(value) {
      return value is string
        && value in ['occasional', 'weekly', 'several_per_week'];
    }

    function validBio(value) {
      return value is string && value.size() <= 160;
    }

    function validCoarsePublicLocation(data) {
      return data.countryCode is string && data.countryCode.size() <= 2
        && data.city is string && data.city.size() <= 80
        && data.area is string && data.area.size() <= 100
        && (!('cityId' in data) || (
          data.cityId is string && data.cityId.size() >= 1
          && data.cityId.size() <= 256 && data.city.size() >= 1
        ))
        && (!('areaId' in data) || (
          data.areaId is string && data.areaId.size() >= 1
          && data.areaId.size() <= 256 && data.area.size() >= 1
        ))
        && ((data.countryCode == '' && data.city == '' && data.area == '')
          || (data.countryCode.size() == 2 && data.city.size() >= 1));
    }

    function validSocialProfile(data) {
      return validPreferredSide(data.preferredSide)
        && validPlayFrequency(data.playFrequency)
        && validBio(data.bio)
        && data.discoverable is bool;
    }

    function validAvatar(data) {
      return !('avatarVersion' in data)
        || (data.avatarVersion is int && data.avatarVersion >= 0);
    }

    function validPrivateUser(userId, data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'level', 'email', 'discoveryLocation',
          'createdAt', 'updatedAt', 'preferredSide', 'playFrequency', 'bio',
          'discoverable'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'level', 'email', 'discoveryLocation',
          'createdAt', 'updatedAt', 'preferredSide', 'playFrequency', 'bio',
          'discoverable', 'avatarVersion'
        ])
        && data.uid == userId
        && data.uid == request.auth.uid
        && validDisplayName(data.displayName)
        && validProfileLevel(data.level)
        && data.email is string && data.email.size() <= 254
        && 'email' in request.auth.token
        && data.email == request.auth.token.email
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && validDiscoveryLocation(data.discoveryLocation)
        && validSocialProfile(data)
        && validAvatar(data);
    }

    function validPublicProfile(userId, data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'level', 'countryCode', 'city', 'area',
          'preferredSide', 'playFrequency', 'bio', 'discoverable'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'level', 'ratingCount', 'ratingSum',
          'ratingAverage', 'countryCode', 'city', 'area', 'preferredSide',
          'cityId', 'areaId',
          'playFrequency', 'bio', 'discoverable', 'completedMatchCount',
          'repeatPlayerCount', 'avatarVersion'
        ])
        && data.uid == userId
        && validDisplayName(data.displayName)
        && validProfileLevel(data.level)
        && validCoarsePublicLocation(data)
        && validSocialProfile(data)
        && validAvatar(data)
        && (!('ratingCount' in data) || (
          data.ratingCount is int && data.ratingCount >= 0
          && data.ratingSum is int && data.ratingSum >= 0
          && data.ratingAverage is number && data.ratingAverage >= 0
          && data.ratingAverage <= 5
        ))
        && (!('completedMatchCount' in data) || (
          data.completedMatchCount is int && data.completedMatchCount >= 0
        ))
        && (!('repeatPlayerCount' in data) || (
          data.repeatPlayerCount is int && data.repeatPlayerCount >= 0
        ));
    }

    function profilesMatchAfter(userId) {
      let privateData = getAfter(
        /databases/$(database)/documents/users/$(userId)
      ).data;
      let publicData = getAfter(
        /databases/$(database)/documents/publicProfiles/$(userId)
      ).data;
      return privateData.uid == publicData.uid
        && privateData.displayName == publicData.displayName
        && privateData.level == publicData.level
        && privateData.preferredSide == publicData.preferredSide
        && privateData.playFrequency == publicData.playFrequency
        && privateData.bio == publicData.bio
        && privateData.discoverable == publicData.discoverable
        && (('avatarVersion' in privateData) == ('avatarVersion' in publicData))
        && (!('avatarVersion' in privateData)
          || privateData.avatarVersion == publicData.avatarVersion)
        && privateData.discoveryLocation.countryCode == publicData.countryCode
        && privateData.discoveryLocation.city == publicData.city
        && privateData.discoveryLocation.area == publicData.area
        && (('cityId' in privateData.discoveryLocation) == ('cityId' in publicData))
        && (!('cityId' in privateData.discoveryLocation)
          || privateData.discoveryLocation.cityId == publicData.cityId)
        && (('areaId' in privateData.discoveryLocation) == ('areaId' in publicData))
        && (!('areaId' in privateData.discoveryLocation)
          || privateData.discoveryLocation.areaId == publicData.areaId);
    }

    function isOrganizer(matchId) {
      let matchData = get(
        /databases/$(database)/documents/matches/$(matchId)
      ).data;
      return verifiedUser() && (
        (
          'creatorUid' in matchData
          && matchData.creatorUid != ''
          && matchData.creatorUid == request.auth.uid
        )
        || (
          (
            !('creatorUid' in matchData)
            || matchData.creatorUid == ''
          )
          && 'createdBy' in matchData
          && matchData.createdBy == request.auth.uid
        )
      );
    }

    function playersIn(matchData) {
      return 'players' in matchData && matchData.players is list
        ? matchData.players
        : [];
    }

    function existingPlayers() {
      return playersIn(resource.data);
    }

    function spotsLeftIn(matchData) {
      return !('spotsLeft' in matchData)
        ? -1
        : matchData.spotsLeft is int
        ? matchData.spotsLeft
        : matchData.spotsLeft in ['1', '1 spot', '1 spot left']
        ? 1
        : matchData.spotsLeft in ['2', '2 spots', '2 spots left']
        ? 2
        : matchData.spotsLeft in ['3', '3 spots', '3 spots left']
        ? 3
        : -1;
    }

    function existingSpotsLeft() {
      return spotsLeftIn(resource.data);
    }

    function playerUid(player) {
      return 'uid' in player
        ? player.uid
        : 'userId' in player
        ? player.userId
        : '';
    }

    function playerIsNotOrganizer(playerUidValue) {
      return matchOrganizerUid(resource.data) != playerUidValue;
    }

    // Convenience query field only. Authorization continues to use creatorUid
    // and players. Every allowed write keeps this projection identical to the
    // authoritative membership stored on the match.
    function validParticipantUids(matchData) {
      let players = playersIn(matchData);
      return matchData.participantUids is list
        && matchData.participantUids.size() == players.size() + 1
        && matchData.participantUids[0] == matchOrganizerUid(matchData)
        && (players.size() < 1
          || matchData.participantUids[1] == playerUid(players[0]))
        && (players.size() < 2
          || matchData.participantUids[2] == playerUid(players[1]))
        && (players.size() < 3
          || matchData.participantUids[3] == playerUid(players[2]));
    }

    function preservesPlayersAndAppendsOne() {
      let before = existingPlayers();
      let after = request.resource.data.players;
      return after.size() == before.size() + 1
        && after.size() <= 3
        && (
          before.size() == 0
          || (
            before.size() == 1
            && after[0] == before[0]
          )
          || (
            before.size() == 2
            && after[0] == before[0]
            && after[1] == before[1]
          )
        );
    }

    function appendedPlayerUid() {
      return request.resource.data.players[existingPlayers().size()].uid;
    }

    function appendedPlayerIsUnique() {
      let before = existingPlayers();
      let appendedUid = appendedPlayerUid();
      return before.size() == 0
        || (
          before.size() == 1
          && playerUid(before[0]) != appendedUid
        )
        || (
          before.size() == 2
          && playerUid(before[0]) != appendedUid
          && playerUid(before[1]) != appendedUid
        );
    }

    function requestIsAtomicallyApproved(matchId, playerUid) {
      return get(
          /databases/$(database)/documents/matches/$(matchId)/joinRequests/$(playerUid)
        ).data.status == 'pending'
        && getAfter(
          /databases/$(database)/documents/matches/$(matchId)/joinRequests/$(playerUid)
        ).data.status == 'approved';
    }

    function appendedPlayerMatchesRequest(matchId, playerUid) {
      let joinRequest = get(
        /databases/$(database)/documents/matches/$(matchId)/joinRequests/$(playerUid)
      ).data;
      let player = request.resource.data.players[existingPlayers().size()];
      return player.keys().hasOnly(['uid', 'displayName', 'level'])
        && player.uid == joinRequest.userId
        && player.displayName == joinRequest.displayName
        && player.level == joinRequest.level;
    }

    function organizerApprovesPendingRequest(matchId) {
      let playerUid = appendedPlayerUid();
      return isOrganizer(matchId)
        && activeAccount(playerUid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['players', 'spotsLeft', 'participantUids'])
        && request.resource.data.players is list
        && request.resource.data.spotsLeft is int
        && validParticipantUids(request.resource.data)
        && existingSpotsLeft() > 0
        && preservesPlayersAndAppendsOne()
        && (
          (
            existingSpotsLeft() - 1
              <= 3 - request.resource.data.players.size()
            && request.resource.data.spotsLeft
              == existingSpotsLeft() - 1
          )
          || (
            existingSpotsLeft() - 1
              > 3 - request.resource.data.players.size()
            && request.resource.data.spotsLeft
              == 3 - request.resource.data.players.size()
          )
        )
        && playerUid is string
        && playerIsNotOrganizer(playerUid)
        && appendedPlayerIsUnique()
        && requestIsAtomicallyApproved(matchId, playerUid)
        && appendedPlayerMatchesRequest(matchId, playerUid);
    }

    function validMatchLocation(location, club) {
      return location is map
        && location.keys().hasAll([
          'clubName', 'countryCode', 'country', 'region', 'city', 'area'
        ])
        && location.keys().hasOnly([
          'clubName', 'countryCode', 'country', 'region', 'city', 'area',
          'placeId', 'formattedAddress', 'latitude', 'longitude'
        ])
        && location.clubName == club
        && location.clubName is string && location.clubName.size() <= 120
        && location.countryCode is string && location.countryCode.size() == 2
        && location.country is string
        && location.country.size() >= 2 && location.country.size() <= 80
        && location.region is string && location.region.size() <= 80
        && location.city is string
        && location.city.size() >= 1 && location.city.size() <= 80
        && location.area is string && location.area.size() <= 100
        && (!('placeId' in location) || (
          location.placeId is string && location.placeId.size() <= 256
        ))
        && (!('formattedAddress' in location) || (
          location.formattedAddress is string
          && location.formattedAddress.size() >= 1
          && location.formattedAddress.size() <= 300
        ))
        && (!('latitude' in location) || (
          location.latitude is number
          && location.latitude >= -90 && location.latitude <= 90
        ))
        && (!('longitude' in location) || (
          location.longitude is number
          && location.longitude >= -180 && location.longitude <= 180
        ))
        && (('latitude' in location) == ('longitude' in location));
    }

    function validNewMatch(matchId) {
      let data = request.resource.data;
      let creatorProfile = get(
        /databases/$(database)/documents/publicProfiles/$(request.auth.uid)
      ).data;
      return data.keys().hasAll([
          'title', 'club', 'clubName', 'location', 'dateTime', 'scheduledAt',
          'level', 'spotsLeft', 'players', 'creatorUid',
          'creatorDisplayName', 'creatorLevel', 'participantUids', 'createdAt'
        ])
        && data.keys().hasOnly([
          'title', 'club', 'clubName', 'location', 'dateTime', 'scheduledAt',
          'level', 'spotsLeft', 'players', 'creatorUid',
          'creatorDisplayName', 'creatorLevel', 'participantUids', 'createdAt'
        ])
        && data.creatorUid == request.auth.uid
        && validDisplayName(data.creatorDisplayName)
        && validProfileLevel(data.creatorLevel)
        && data.creatorDisplayName == creatorProfile.displayName
        && data.creatorLevel == creatorProfile.level
        && data.title is string && data.title.size() >= 1
        && data.title.size() <= 100
        && data.dateTime is string && data.dateTime.size() >= 1
        && data.dateTime.size() <= 100
        && data.club is string && data.club.size() >= 1
        && data.club.size() <= 120
        && data.clubName == data.club
        && validMatchLocation(data.location, data.club)
        && validMatchLevel(data.level)
        && data.scheduledAt is timestamp && data.scheduledAt > request.time
        && data.createdAt == request.time
        && data.players is list && data.players.size() == 0
        && validParticipantUids(data)
        && data.spotsLeft is int
        && data.spotsLeft >= 1 && data.spotsLeft <= 3;
    }

    function organizerEditsMatchDetails(matchId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isOrganizer(matchId)
        && matchIsStillOpen(request.resource.data)
        && (
          !('source' in resource.data)
          || resource.data.source != 'matchmaking'
          || changed.hasOnly(['title'])
        )
        && changed.hasOnly([
          'title', 'dateTime', 'scheduledAt', 'club', 'clubName', 'location',
          'level', 'spotsLeft'
        ])
        && changed.hasAny([
          'title', 'dateTime', 'scheduledAt', 'club', 'clubName', 'location',
          'level', 'spotsLeft'
        ])
        && request.resource.data.players == resource.data.players
        && request.resource.data.spotsLeft is int
        && request.resource.data.spotsLeft >= 0
        && request.resource.data.spotsLeft <= 3 - existingPlayers().size()
        && request.resource.data.title is string
        && request.resource.data.dateTime is string
        && request.resource.data.scheduledAt is timestamp
        && request.resource.data.club is string
        && request.resource.data.club != ''
        && request.resource.data.clubName == request.resource.data.club
        && validMatchLevel(request.resource.data.level)
        && validMatchLocation(
          request.resource.data.location,
          request.resource.data.club
        );
    }

    function approvalUpdatesMatch(matchId, playerUid) {
      let matchBefore = get(
        /databases/$(database)/documents/matches/$(matchId)
      ).data;
      let matchAfter = getAfter(
        /databases/$(database)/documents/matches/$(matchId)
      ).data;
      let playersBefore = playersIn(matchBefore);
      let spotsBefore = spotsLeftIn(matchBefore);
      return matchAfter.players.size() == playersBefore.size() + 1
        && matchAfter.players[playersBefore.size()].uid == playerUid
        && (
          (
            spotsBefore - 1 <= 3 - matchAfter.players.size()
            && matchAfter.spotsLeft == spotsBefore - 1
          )
          || (
            spotsBefore - 1 > 3 - matchAfter.players.size()
            && matchAfter.spotsLeft == 3 - matchAfter.players.size()
          )
        );
    }

    function matchContainsPlayer(matchData, playerUidValue) {
      let players = playersIn(matchData);
      return (players.size() > 0 && playerUid(players[0]) == playerUidValue)
        || (players.size() > 1 && playerUid(players[1]) == playerUidValue)
        || (players.size() > 2 && playerUid(players[2]) == playerUidValue);
    }

    function matchOrganizerUid(matchData) {
      return 'creatorUid' in matchData && matchData.creatorUid != ''
        ? matchData.creatorUid
        : 'createdBy' in matchData
        ? matchData.createdBy
        : '';
    }

    function userParticipated(matchData, uid) {
      return matchContainsPlayer(matchData, uid)
        || matchOrganizerUid(matchData) == uid;
    }

    function matchIsCompleted(matchData) {
      return 'scheduledAt' in matchData
        && matchData.scheduledAt is timestamp
        && matchData.scheduledAt <= request.time;
    }

    function matchIsStillOpen(matchData) {
      return 'scheduledAt' in matchData
        && matchData.scheduledAt is timestamp
        && matchData.scheduledAt > request.time;
    }

    function matchCanStillChange(matchId) {
      let matchData = get(
        /databases/$(database)/documents/matches/$(matchId)
      ).data;
      return !('scheduledAt' in matchData) || matchIsStillOpen(matchData);
    }

    function validRating(matchId, raterUid, ratedUid) {
      let data = request.resource.data;
      let matchData = get(
        /databases/$(database)/documents/matches/$(matchId)
      ).data;
      return data.keys().hasAll([
          'matchId', 'raterUid', 'ratedUid', 'rating', 'createdAt'
        ])
        && data.keys().hasOnly([
          'matchId', 'raterUid', 'ratedUid', 'rating', 'createdAt'
        ])
        && data.matchId == matchId
        && data.raterUid == request.auth.uid
        && data.raterUid == raterUid
        && data.ratedUid is string
        && data.ratedUid != ''
        && data.ratedUid == ratedUid
        && data.raterUid != data.ratedUid
        && activePublicAccount(data.ratedUid)
        && data.rating is int
        && data.rating >= 1
        && data.rating <= 5
        && data.createdAt == request.time
        && matchIsCompleted(matchData)
        && userParticipated(matchData, data.raterUid)
        && userParticipated(matchData, data.ratedUid);
    }

    function validRequestFields() {
      let publicProfile = get(
        /databases/$(database)/documents/publicProfiles/$(request.auth.uid)
      ).data;
      return request.resource.data.keys().hasAll([
          'userId', 'displayName', 'level', 'status', 'requestedAt',
          'eventId'
        ])
        && request.resource.data.keys().hasOnly([
          'userId', 'displayName', 'level', 'status', 'requestedAt',
          'eventId'
        ])
        && request.resource.data.userId is string
        && validDisplayName(request.resource.data.displayName)
        && validProfileLevel(request.resource.data.level)
        && request.resource.data.displayName == publicProfile.displayName
        && request.resource.data.level == publicProfile.level
        && request.resource.data.eventId is string
        && request.resource.data.eventId.size() >= 1
        && request.resource.data.eventId.size() <= 128
        && request.resource.data.requestedAt == request.time;
    }

    function notificationRecipientIsOrganizer(matchData, recipientUid) {
      return (
          'creatorUid' in matchData
          && matchData.creatorUid != ''
          && matchData.creatorUid == recipientUid
        )
        || (
          (!('creatorUid' in matchData) || matchData.creatorUid == '')
          && 'createdBy' in matchData
          && matchData.createdBy == recipientUid
        )
        ;
    }

    function validJoinRequestNotification(notificationId) {
      let data = request.resource.data;
      let matchData = get(
        /databases/$(database)/documents/matches/$(data.matchId)
      ).data;
      let requestPath = /databases/$(database)/documents/matches/$(data.matchId)/joinRequests/$(request.auth.uid);
      let requestAfter = getAfter(requestPath).data;
      return data.keys().hasOnly([
          'type', 'recipientUid', 'matchId', 'matchClubName', 'title',
          'message', 'isRead', 'createdAt', 'eventId', 'actorUid',
          'actorDisplayName'
        ])
        && data.type == 'join_request'
        && data.actorUid == request.auth.uid
        && data.actorUid != data.recipientUid
        && activeAccount(data.recipientUid)
        && data.actorDisplayName == requestAfter.displayName
        && data.matchClubName == matchData.club
        && data.title == 'New join request'
        && data.message == requestAfter.displayName
          + ' requested to join your match at ' + matchData.club + '.'
        && data.isRead == false
        && data.createdAt == request.time
        && data.eventId is string
        && data.eventId != ''
        && notificationId == 'join_request_' + data.matchId + '_' + data.eventId
        && notificationRecipientIsOrganizer(matchData, data.recipientUid)
        && requestAfter.userId == request.auth.uid
        && requestAfter.status == 'pending'
        && requestAfter.eventId == data.eventId
        && (
          (!exists(requestPath) && existsAfter(requestPath))
          || (
            exists(requestPath)
            && get(requestPath).data.status == 'declined'
            && (
              !('eventId' in get(requestPath).data)
              || get(requestPath).data.eventId != data.eventId
            )
          )
        );
    }

    function validReviewNotification(notificationId) {
      let data = request.resource.data;
      let matchData = get(
        /databases/$(database)/documents/matches/$(data.matchId)
      ).data;
      let requestPath = /databases/$(database)/documents/matches/$(data.matchId)/joinRequests/$(data.recipientUid);
      let requestBefore = get(requestPath).data;
      let requestAfter = getAfter(requestPath).data;
      let approved = data.type == 'join_approved';
      let expectedStatus = approved ? 'approved' : 'declined';
      let expectedTitle = approved ? 'Request approved' : 'Request declined';
      let expectedMessage = 'Your request to join the match at '
        + matchData.club + ' was ' + expectedStatus + '.';
      return data.keys().hasOnly([
          'type', 'recipientUid', 'matchId', 'matchClubName', 'title',
          'message', 'isRead', 'createdAt', 'eventId', 'actorUid',
          'actorDisplayName'
        ])
        && data.type in ['join_approved', 'join_declined']
        && data.actorUid == request.auth.uid
        && data.actorUid != data.recipientUid
        && activeAccount(data.recipientUid)
        && data.actorDisplayName is string
        && data.matchClubName == matchData.club
        && data.title == expectedTitle
        && data.message == expectedMessage
        && data.isRead == false
        && data.createdAt == request.time
        && data.eventId is string
        && data.eventId != ''
        && notificationId == data.type + '_' + data.matchId + '_' + data.eventId
        && isOrganizer(data.matchId)
        && requestBefore.userId == data.recipientUid
        && requestBefore.status == 'pending'
        && requestAfter.status == expectedStatus
        && requestAfter.eventId == data.eventId;
    }

    match /users/{userId} {
      allow read: if verifiedUser() && request.auth.uid == userId;
      allow create: if verifiedUser()
        && request.auth.uid == userId
        && validPrivateUser(userId, request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(
          /databases/$(database)/documents/publicProfiles/$(userId)
        )
        && profilesMatchAfter(userId);
      allow update: if verifiedUser()
        && request.auth.uid == userId
        && validPrivateUser(userId, request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && existsAfter(
          /databases/$(database)/documents/publicProfiles/$(userId)
        )
        && profilesMatchAfter(userId);
      allow delete: if false;

      match /playedWith/{otherUid} {
        allow read: if verifiedUser() && request.auth.uid == userId;
        allow write: if false;
      }

      match /friendViews/{otherUid} {
        allow read: if verifiedUser() && request.auth.uid == userId;
        allow write: if false;
      }

      match /conversationViews/{conversationId} {
        allow read, write: if false;
      }

      // Matchmaking canonical state remains server-only. These projections
      // expose only the signed-in member's own request and offer state.
      match /matchmakingRequestViews/{requestId} {
        allow read: if verifiedUser() && request.auth.uid == userId;
        allow write: if false;
      }

      match /matchProposalViews/{proposalId} {
        allow read: if verifiedUser() && request.auth.uid == userId;
        allow write: if false;
      }

      match /settings/{settingId} {
        allow read: if verifiedUser()
          && request.auth.uid == userId
          && settingId == 'notifications';
        allow create, update: if verifiedUser()
          && request.auth.uid == userId
          && settingId == 'notifications'
          && request.resource.data.keys().hasAll([
            'pushEnabled', 'matchMessages', 'joinRequests',
            'friendRequests', 'friendAccepted', 'matchUpdates', 'playAgain',
            'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'pushEnabled', 'matchMessages', 'joinRequests',
            'friendRequests', 'friendAccepted', 'matchUpdates', 'playAgain',
            'updatedAt'
          ])
          && request.resource.data.pushEnabled is bool
          && request.resource.data.matchMessages is bool
          && request.resource.data.joinRequests is bool
          && request.resource.data.friendRequests is bool
          && request.resource.data.friendAccepted is bool
          && request.resource.data.matchUpdates is bool
          && request.resource.data.playAgain is bool
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
    }

    match /pushDevices/{tokenHash} {
      allow read, write: if false;
    }

    match /pushDeliveryReceipts/{notificationId} {
      allow read, write: if false;
    }

    match /conversations/{conversationId} {
      allow read, write: if false;
      match /messages/{messageId} {
        allow read, write: if false;
      }
    }

    match /messagingRateLimits/{userId} {
      allow read, write: if false;
    }

    match /playAgainRateLimits/{userId} {
      allow read, write: if false;
    }

    match /publicProfiles/{userId} {
      allow read: if verifiedUser();
      allow create: if verifiedUser()
        && request.auth.uid == userId
        && validPublicProfile(userId, request.resource.data)
        && !request.resource.data.keys().hasAny([
          'ratingCount', 'ratingSum', 'ratingAverage',
          'completedMatchCount', 'repeatPlayerCount'
        ])
        && existsAfter(/databases/$(database)/documents/users/$(userId))
        && profilesMatchAfter(userId);
      allow update: if verifiedUser()
        && request.auth.uid == userId
        && validPublicProfile(userId, request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'displayName', 'level', 'countryCode', 'city', 'cityId', 'area',
            'areaId',
            'preferredSide', 'playFrequency', 'bio', 'discoverable',
            'avatarVersion'
          ])
        && existsAfter(/databases/$(database)/documents/users/$(userId))
        && profilesMatchAfter(userId);
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if verifiedUser()
        && resource.data.recipientUid == request.auth.uid;
      allow create: if verifiedUser() && (
        validJoinRequestNotification(notificationId)
        || validReviewNotification(notificationId)
      );
      allow update: if verifiedUser()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.recipientUid == request.auth.uid
        && resource.data.isRead == false
        && request.resource.data.isRead == true
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isRead']);
      allow delete: if false;
    }

    // Server-owned lifecycle records. Rules can inspect barriers even though
    // clients cannot read or mutate their contents. Any barrier blocks access,
    // including completed jobs; clients cannot clear it by changing status.
    match /accountDeletionBarriers/{uid} {
      allow read, write: if false;
    }
    match /accountDeletionJobs/{uid} {
      allow read, write: if false;
    }
    match /accountDeletionOutbox/{uid} {
      allow read, write: if false;
    }
    match /accountEligibility/{uid} {
      allow read, create, update, delete: if false;
    }
    match /accountLegalAcceptance/{uid} {
      allow read, create, update, delete: if false;
    }
    match /accountEnforcement/{uid} {
      allow read, create, update, delete: if false;
    }
    match /moderationActions/{actionId} {
      allow read, create, update, delete: if false;
    }
    match /reports/{reportId} {
      allow read, create, update, delete: if false;
    }
    match /reportRateLimits/{document=**} {
      allow read, create, update, delete: if false;
    }
    match /ratingContributions/{contributionId} {
      allow read, write: if false;
    }
    match /playedWithMatchContributions/{matchId} {
      allow read, write: if false;
    }
    match /playedWithContributions/{contributionId} {
      allow read, write: if false;
    }
    match /playedWithPairs/{pairId} {
      allow read, write: if false;
    }
    match /matchmakingRequests/{requestId} {
      allow read, write: if false;
    }
    match /matchmakingActiveOwners/{uid} {
      allow read, write: if false;
    }
    match /matchProposals/{proposalId} {
      allow read, write: if false;
    }
    match /reliabilityEvents/{eventId} {
      allow read, write: if false;
    }
    match /reliabilityProfiles/{uid} {
      allow get: if verifiedUser();
      allow list, create, update, delete: if false;
    }
    match /attendanceEvidence/{evidenceId} {
      allow read, write: if false;
    }
    match /attendanceSubmissions/{submissionId} {
      allow read, write: if false;
    }
    match /attendanceResolutions/{matchId} {
      allow read, write: if false;
    }
    match /attendanceResolutionJobs/{matchId} {
      allow read, write: if false;
    }
    match /matchPrivateVenues/{matchId} {
      allow read: if verifiedUser()
        && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.participantUids;
      allow write: if false;
    }
    match /friendships/{pairId} {
      allow read, write: if false;
    }
    match /blocks/{blockId} {
      allow get: if verifiedUser()
        && resource.data.blockerUid == request.auth.uid;
      allow list, write: if false;
    }
    match /socialProjectionState/{stateId} {
      allow read, write: if false;
    }

    // Legacy event markers remain server-only until the accounting transition.
    match /ratingAggregationEvents/{eventId} {
      allow read, write: if false;
    }

    // A collection-group query is not confined to the /matches parent path,
    // so it needs an explicit recursive-wildcard rule. Join-request writes
    // guarantee that userId belongs to the requester and later updates cannot
    // change it. This therefore exposes only the signed-in player's own
    // requests, while organizer collection reads remain match-scoped below.
    match /{path=**}/joinRequests/{requestId} {
      allow list: if verifiedUser()
        && resource.data.userId == request.auth.uid;
    }

    // Public profiles aggregate immutable rating records with a targeted
    // collection-group query. Writes remain match-scoped below.
    match /{path=**}/ratings/{ratingId} {
      allow read: if false;
    }

    match /matches/{matchId} {
      allow read: if verifiedUser();
      allow create: if verifiedUser()
        && validNewMatch(matchId);
      allow delete: if isOrganizer(matchId) && matchCanStillChange(matchId);

      // Match updates are limited to organizer detail edits or atomic
      // organizer approval. Participant departure is server-authoritative
      // through leaveMatch and is no longer a direct client mutation.
      // None of these paths can change ownership or join-request state.
      allow update: if verifiedUser()
        && (
          !('scheduledAt' in resource.data)
          || matchIsStillOpen(resource.data)
        )
        && (
          organizerEditsMatchDetails(matchId)
          || (
            (!('source' in resource.data) || resource.data.source != 'matchmaking')
            && organizerApprovesPendingRequest(matchId)
          )
        );

      match /joinRequests/{userId} {
        allow get: if verifiedUser()
          && (request.auth.uid == userId || isOrganizer(matchId));
        allow list: if verifiedUser()
          && (isOrganizer(matchId) || request.auth.uid == resource.data.userId);

        // A non-organizer can create only their own pending request.
        allow create: if verifiedUser()
          && matchCanStillChange(matchId)
          && (
            !('source' in get(/databases/$(database)/documents/matches/$(matchId)).data)
            || get(/databases/$(database)/documents/matches/$(matchId)).data.source != 'matchmaking'
          )
          && request.auth.uid == userId
          && !isOrganizer(matchId)
          && request.resource.data.userId == request.auth.uid
          && activeAccount(matchOrganizerUid(get(/databases/$(database)/documents/matches/$(matchId)).data))
          && request.resource.data.status == 'pending'
          && validRequestFields();

        // Requesters may retry only after decline. Only the organizer may
        // transition a pending request to approved or declined.
        allow update: if verifiedUser() && matchCanStillChange(matchId) && (
          (
            request.auth.uid == userId
            && !isOrganizer(matchId)
            && resource.data.status == 'declined'
            && activeAccount(matchOrganizerUid(get(/databases/$(database)/documents/matches/$(matchId)).data))
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.status == 'pending'
            && validRequestFields()
          )
          || (
            isOrganizer(matchId)
            && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'eventId'])
            && (
              (
                'eventId' in resource.data
                && request.resource.data.eventId == resource.data.eventId
              )
              || (
                !('eventId' in resource.data)
                && request.resource.data.eventId is string
                && request.resource.data.eventId != ''
              )
            )
            && request.resource.data.status in ['approved', 'declined']
            && (
              request.resource.data.status == 'declined'
              || approvalUpdatesMatch(matchId, userId)
            )
          )
        );

        allow delete: if isOrganizer(matchId) && matchCanStillChange(matchId);
      }

      match /invites/{inviteeUid} {
        allow read: if verifiedUser() && request.auth.uid == inviteeUid;
        allow write: if false;
      }


      match /ratingRaters/{raterUid}/ratings/{ratedUid} {
        allow read: if false;
        allow create: if verifiedUser()
          && validRating(matchId, raterUid, ratedUid);
        allow update, delete: if false;
      }
    }
  }
}
